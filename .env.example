# Copy to .env and fill in. Never commit .env.
# Generate a password with: openssl rand -base64 32

POSTGRES_USER=connect
POSTGRES_PASSWORD=
POSTGRES_DB=connect

# Host port for the app container, bound to 127.0.0.1 only.
# Verify nothing else on the VPS uses it:  ss -tlnp | grep 8097
HOST_PORT=8097

PUBLIC_ORIGIN=https://connect.sirony.in
LOG_LEVEL=info
